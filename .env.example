# PayPal Developer Sandbox Configuration (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave as "test" or blank to use PayPal JS SDK Sandbox Test Mode + Interactive PayPal Orders v2 Simulator
NEXT_PUBLIC_PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# AI Clinical & Price Auditor (Google Gemini API — optional; falls back to deterministic Clinical Reference Engine if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Docarion Platform Bridge URL
NEXT_PUBLIC_DOCARION_API_URL=https://docarion.com/api/v1
